# ============================================================================
# Storyline to Google Sheets Script Generator SaaS - Environment Configuration
# ============================================================================
# Copy this file to .env.local for local development or configure these
# variables in Vercel Dashboard -> Project Settings -> Environment Variables.
# NEVER commit .env or .env.local to Git.

# 1. Firebase Configuration (Project: shahar-storyline-saas)
FIREBASE_PROJECT_ID=shahar-storyline-saas
FIREBASE_API_KEY=AIzaSyAtt8KrtnXH1S7tglh739Y2-YGO2xtvbpU

# Service Account JSON (minified single-line JSON string from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_SERVICE_ACCOUNT_JSON=

# 2. Tranzila Payment & Billing Configuration
# Mode: "live" (connected to Tranzila terminals) or "mock" (offline simulator)
TRANZILA_MODE=live

# Regular / Checkout Terminal (DirectNG iFrame + Handshake)
TRANZILA_CHECKOUT_TERMINAL_NAME=shaher1
TRANZILA_CHECKOUT_PASSWORD=
TRANZILA_CHECKOUT_CREDIT_PASSWORD=

# Token / Standing Order (STO) Terminal (My Billing Recurring & Cancellation)
TRANZILA_TERMINAL_NAME=shaher1tok
TRANZILA_TOKEN_PASSWORD=
TRANZILA_TOKEN_CREDIT_PASSWORD=

# Tranzila API V1/V2 HMAC Credentials (Shared across both terminals)
TRANZILA_API_USERNAME=shaher1
TRANZILA_API_APP_KEY=
TRANZILA_API_SECRET=

# Secret token used to verify incoming Tranzila webhooks (/api/webhooks/tranzila)
TRANZILA_WEBHOOK_SECRET=replace_with_random_32_byte_secret

# Optional manual Invoices API call (leave false when terminal Invoices module issues documents automatically via Ilang=HEB & json_purchase_data)
TRANZILA_INVOICES_API_ENABLED=false

# Public base URL of the deployed site (used for Tranzila notify_url / success_url / fail_url in production)
# PUBLIC_APP_URL=https://shaharsolutions.com
