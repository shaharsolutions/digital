{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/roam-staging",
      "destination": "https://roam-server.shaharsolutions.com/roam-staging/"
    },
    {
      "source": "/roam-staging/",
      "destination": "https://roam-server.shaharsolutions.com/roam-staging/"
    },
    {
      "source": "/roam-staging/:path*",
      "destination": "https://roam-server.shaharsolutions.com/roam-staging/:path*"
    },
    {
      "source": "/roam",
      "destination": "https://roam-server.shaharsolutions.com/roam/"
    },
    {
      "source": "/roam/",
      "destination": "https://roam-server.shaharsolutions.com/roam/"
    },
    {
      "source": "/roam/:path*",
      "destination": "https://roam-server.shaharsolutions.com/roam/:path*"
    },
    {
      "source": "/finance",
      "destination": "https://roam-server.shaharsolutions.com/finance"
    },
    {
      "source": "/finance/",
      "destination": "https://roam-server.shaharsolutions.com/finance/"
    },
    {
      "source": "/finance/:path*",
      "destination": "https://roam-server.shaharsolutions.com/finance/:path*"
    }
  ]
}
